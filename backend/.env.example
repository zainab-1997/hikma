## Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_VERSION=1.0.0-rc1
APP_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
TRUSTED_PROXY_COUNT=0
MAX_UPLOAD_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30

## Storage paths are relative to the backend working directory unless absolute.
DATABASE_URL=sqlite:///./database/app.db
GENERATED_ORDERS_DIR=generated_orders
EXCEL_TEMPLATE_PATH=templates/Hikma orders.xlsx
GENERATED_FILE_RETENTION_DAYS=30

## AI parser. Select exactly one provider and never commit real keys.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Email delivery is off by default. Leave EMAIL_ENABLED=false until real SMTP
# credentials are configured — sending fails safely (not silently) while disabled.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Hikma Orders
DEFAULT_ORDER_RECIPIENTS=
